rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every document a user owns lives under users/{uid}/** (foods, dailyLogs,
    // and their meals/items subcollections) — see DailyTrainer_SPEC.md section 4.2.
    // A single recursive rule covers all of it: only the owning uid may read/write.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
